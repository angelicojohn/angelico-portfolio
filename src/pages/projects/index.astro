---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Work from '../../components/sections/Work.astro';
import Cta from '../../components/sections/Cta.astro';
import { projects } from '../../data/projects';
---
<Base
  title="Projects | AJ, Webflow Developer"
  description="Production Webflow and Framer websites built, developed or maintained by AJ."
>
  <PageHero
    words={['Selected.', 'Projects.', 'Shipped.']}
    label="Projects"
    title="Production Webflow work."
    lede={`A selection of websites I've built, developed or maintained professionally: ${projects.length} projects across Astro, Webflow and Framer.`}
    logo={false}
    primary={{ href: '#work', label: 'Browse Projects' }}
    secondary={{ href: '#contact', label: 'Get In Touch' }}
  />
  <Work all />
  <Cta />
</Base>
