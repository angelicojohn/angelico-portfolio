---
// Homepage: Astro development + client-benefit positioning (merged from the former /astro page).
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Value from '../components/sections/Value.astro';
import Intro from '../components/sections/Intro.astro';
import Workflow from '../components/sections/Workflow.astro';
import Cost from '../components/sections/Cost.astro';
import Platforms from '../components/sections/Platforms.astro';
import Compare from '../components/sections/Compare.astro';
import Custom from '../components/sections/Custom.astro';
import Stack from '../components/sections/Stack.astro';
import WebApp from '../components/sections/WebApp.astro';
import AiWorkflow from '../components/sections/AiWorkflow.astro';
import SeoAeo from '../components/sections/SeoAeo.astro';
import Process from '../components/sections/Process.astro';
import AstroProjects from '../components/sections/AstroProjects.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Experience from '../components/sections/Experience.astro';
import Roi from '../components/sections/Roi.astro';
import Pricing from '../components/sections/Pricing.astro';
import Care from '../components/sections/Care.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import { process, faqs } from '../data/home';
const schema = [
  { '@type': 'Service', name: 'Custom Astro websites and migrations', serviceType: 'Website design and development', description: 'Custom websites built in Astro with Sanity for content editing, plus migrations from Webflow, Framer, WordPress or Wix, using AI-assisted workflows with hands-on design, development and testing.', areaServed: 'Worldwide' },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) },
];
---
<Base schema={schema}>
  <Hero />
  <Value />
  <Intro />
  <Workflow />
  <Cost />
  <Roi />
  <Platforms />
  <Compare />
  <Custom />
  <Stack />
  <WebApp />
  <AiWorkflow />
  <SeoAeo />
  <AstroProjects />
  <Testimonials />
  <Pricing />
  <Care />
  <Process steps={process.steps} title={process.title as [string, string]} eyebrow="" intro={process.intro} />
  <Experience />
  <Faq faqs={faqs} title="Questions, answered." />
  <Cta />
</Base>
