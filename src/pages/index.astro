---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Value from '../components/sections/Value.astro';
import Intro from '../components/sections/Intro.astro';
import Custom from '../components/sections/Custom.astro';
import Workflow from '../components/sections/Workflow.astro';
import Timelines from '../components/sections/Timelines.astro';
import Cost from '../components/sections/Cost.astro';
import Process from '../components/sections/Process.astro';
import AiWorkflow from '../components/sections/AiWorkflow.astro';
import Editing from '../components/sections/Editing.astro';
import Services from '../components/sections/Services.astro';
import Work from '../components/sections/Work.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Tools from '../components/sections/Tools.astro';
import Experience from '../components/sections/Experience.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import { process, faqs } from '../data/home';
const schema = [
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) },
];
---
<Base schema={schema}>
  <Hero />
  <Value />
  <Intro />
  <Custom />
  <Workflow />
  <Timelines />
  <Cost />
  <Process steps={process.steps} title={process.title as [string, string]} eyebrow="" intro={process.intro} />
  <AiWorkflow />
  <Editing />
  <Services />
  <Work eyebrow="Real projects" lede="Websites I’ve built, developed or maintained professionally, across Astro, Webflow and Framer." />
  <Testimonials />
  <Tools />
  <Experience />
  <Faq faqs={faqs} title="Questions, answered." />
  <Cta />
</Base>
