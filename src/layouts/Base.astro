---
import '../styles/global.css';
import Loader from '../components/osmo/Loader.astro';
import Nav from '../components/osmo/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { site as siteData } from '../data/site';

interface Props { title?: string; description?: string; schema?: Record<string, unknown>[]; }
const {
  title = 'AJ | Custom Website Design & Development',
  description = 'Custom websites designed around your business, built faster with AI-assisted workflows and hands-on experience in Webflow, Framer and Astro. Easy to manage after launch.',
  schema = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteSchema = {
  '@type': 'ProfessionalService',
  name: `${siteData.name}, ${siteData.role}`,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  description: 'Custom website design and development using AI-assisted workflows: new websites, redesigns, integrations and ongoing support, built in Webflow, Framer or Astro.',
  founder: { '@type': 'Person', name: siteData.name, jobTitle: siteData.role },
  areaServed: 'Worldwide',
  knowsAbout: ['Webflow', 'Framer', 'Astro', 'Sanity', 'GSAP', 'Technical SEO', 'Answer Engine Optimization'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
    <SchemaOrg schema={[siteSchema, ...schema]} />
    <meta name="theme-color" content="#2f54ff" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%232f54ff'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <noscript>
      <style>
        .loading-container { display: none; }
        [data-split="heading"], [data-highlight-marker-reveal] { visibility: visible; }
        .hero__media-overlay { display: none; }
      </style>
    </noscript>
  </head>
  <body>
    <Loader />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
