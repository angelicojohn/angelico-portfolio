---
import '../styles/global.css';
import Loader from '../components/osmo/Loader.astro';
import Nav from '../components/osmo/Nav.astro';
import Footer from '../components/sections/Footer.astro';

interface Props { title?: string; description?: string; }
const {
  title = 'AJ — Webflow Developer',
  description = 'Webflow Developer building polished, production-ready websites: Figma → Webflow, CMS architecture, custom code, motion and integrations.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#2f54ff" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%232f54ff'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <noscript>
      <style>
        .loading-container { display: none; }
        [data-split="heading"], [data-highlight-marker-reveal] { visibility: visible; }
        .hero__media-overlay { display: none; }
      </style>
    </noscript>
  </head>
  <body>
    <Loader />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
