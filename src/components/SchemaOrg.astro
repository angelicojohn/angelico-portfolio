---
// JSON-LD structured data (SEO + AEO). Pass any number of schema objects.
interface Props { schema: Record<string, unknown> | Record<string, unknown>[]; }
const { schema } = Astro.props;
const list = Array.isArray(schema) ? schema : [schema];
---
{list.map((s) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...s })} />)}
