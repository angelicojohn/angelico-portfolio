---
// BYQ: babka-faq-1 layout as an accordion (stringer-faq-1 behaviour: one open at a time)
// Native <details name="faq"> = exclusive accordion, keyboard accessible, answers stay in the HTML for SEO.
import { faqs as astroFaqs } from '../../data/astro';
interface Props { faqs?: { question: string; answer: string }[]; title?: string; label?: string }
const { faqs = astroFaqs, title = 'Before you ask.', label = 'Questions' } = Astro.props;
---
<section class="faq" id="faq">
  <div class="container">
    <div class="faq__grid">
      <div class="faq__aside">
        <span class="pill-label">{label}</span>
        <h2 class="faq__title section-title" data-split="heading">{title}</h2>
      </div>
      <div class="faq__list">
        {faqs.map((f, i) => (
          <details class="faq__item" name="faq" open={i === 0}>
            <summary class="faq__q">
              <span>{f.question}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq__a-wrap"><p class="faq__a">{f.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
