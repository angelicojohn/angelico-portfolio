---
// BYQ: consult-ai-hero-4  ·  Osmo: Masked Text Reveal (chars)
const tools = ['Webflow', 'Framer', 'Figma', 'HTML', 'CSS', 'JavaScript', 'GSAP', 'jQuery', 'Finsweet', 'GTM', 'CMS', 'Technical SEO'];
---
<section class="experience" id="experience">
  <div class="container">
    <div class="experience__grid">
      <div>
        <div class="experience__sticky">
          <span class="experience__tag">Experience</span>
          <h2 class="experience__title">
            <span data-split="heading">Agency-tested.</span>
            <span data-split="heading">Production-focused.</span>
          </h2>
          <div class="experience__text">
            <p>Over the past 3+ years, I've worked across 40+ website builds, ongoing support projects and client websites — primarily working with agencies and international businesses.</p>
            <p>I'm comfortable receiving an approved design, identifying implementation concerns, building independently, working through QA feedback and carrying the website through to production.</p>
          </div>
          <ul class="tool-list" aria-label="Tools">
            {tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>

      <div class="experience__stats">
        <div class="stat">
          <div class="stat__value" data-split="heading" data-split-reveal="chars">3+</div>
          <div class="stat__label">years of professional agency experience</div>
        </div>
        <div class="stat">
          <div class="stat__value" data-split="heading" data-split-reveal="chars">40+</div>
          <div class="stat__label">websites built, developed or maintained</div>
        </div>
      </div>
    </div>
  </div>
  <img class="experience__ball" src="/images/byq/ball-abstract-white.webp" alt="" loading="lazy" />
</section>
