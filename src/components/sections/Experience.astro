---
import { url } from '../../lib/url';
// BYQ: consult-ai-hero-4  ·  Osmo: Masked Text Reveal (chars)
const tools = ['Astro', 'Sanity', 'Figma', 'HTML', 'CSS', 'JavaScript', 'GSAP', 'Claude Code', 'Codex', 'n8n', 'GTM', 'Technical SEO'];
---
<section class="experience" id="experience">
  <div class="container">
    <div class="experience__grid">
      <div>
        <div class="experience__sticky">
          <span class="experience__tag">Experience</span>
          <h2 class="experience__title section-title" data-split="heading">
            <span>Agency-tested. </span><span>Production-focused.</span>
          </h2>
          <div class="experience__text">
            <p>Over the past 3+ years I've worked on 40+ websites, from new builds to ongoing support, mostly for agencies and international businesses.</p>
            <p>I'm used to taking an approved design, flagging anything that could cause problems in the build, building it on my own, working through QA feedback and getting the site into production.</p>
          </div>
          <ul class="tool-list" aria-label="Tools">
            {tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>

      <div class="experience__stats">
        <div class="stat">
          <div class="stat__value" data-split="heading" data-split-reveal="chars">3+</div>
          <div class="stat__label">years of professional agency experience</div>
        </div>
        <div class="stat">
          <div class="stat__value" data-split="heading" data-split-reveal="chars">40+</div>
          <div class="stat__label">websites built, developed or maintained</div>
        </div>
      </div>
    </div>
  </div>
  <img class="experience__ball" src={url('/images/byq/ball-abstract-white.webp')} alt="" loading="lazy" />
</section>
