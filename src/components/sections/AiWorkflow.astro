---
// BYQ: nextwell-intro-text-5  ·  Osmo: Highlight Text on Scroll
import { ai } from '../../data/home';
---
<section class="ai" id="ai">
  <div class="container">
    <div class="ai__panel">
      <div class="ai__content">
        <span class="pill-label ai__label">{ai.label}</span>
        <h2 class="ai__title section-title" data-split="heading">{ai.title}</h2>
        <div class="ai__grid">
          <div class="ai__text">
            <p>{ai.paragraphs[0]}</p>
            <p class="ai__text-muted" style="margin-top:1em">{ai.paragraphs[1]}</p>
          </div>
          <ul class="ai__tools" aria-label="AI tools">
            {ai.tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <ul class="ai__principles" role="list">
          {ai.principles.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
