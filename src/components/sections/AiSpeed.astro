---
// AI-assisted speed — split "AI handles / I make sure" after BYQ nextwell panel  ·  Osmo: Highlight Text on Scroll
import { aiSpeed } from '../../data/astro';
---
<section class="aispeed" id="ai-speed">
  <div class="container">
    <div class="aispeed__head">
      <span class="pill-label">AI-assisted development</span>
      <h2 class="aispeed__title" data-highlight-text data-highlight-fade="0.25">{aiSpeed.title}</h2>
      <p class="aispeed__intro">{aiSpeed.intro}</p>
    </div>
    <div class="aispeed__split">
      <div class="aispeed__col">
        <h3 class="aispeed__col-title"><span class="aispeed__tag">AI</span> speeds up</h3>
        <ul class="aispeed__list">{aiSpeed.ai.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="aispeed__col is--me">
        <h3 class="aispeed__col-title"><span class="aispeed__tag">AJ</span> makes sure of</h3>
        <ul class="aispeed__list">{aiSpeed.me.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </div>
</section>
