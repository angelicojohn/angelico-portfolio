---
// Speed: traditional vs modern workflow, two flow rows (balanced, factual).  ·  Osmo: Masked Text Reveal
import { workflow } from '../../data/home';
const rows = [
  { ...workflow.traditional, kind: 'traditional' },
  { ...workflow.modern, kind: 'modern' },
];
---
<section class="workflow" id="timeline">
  <div class="container">
    <div class="workflow__head">
      <h2 class="workflow__title">
        {workflow.title.map((line) => <span data-split="heading">{line}</span>)}
      </h2>
      <p class="workflow__intro">{workflow.intro}</p>
    </div>
    <div class="workflow__rows">
      {rows.map((row) => (
        <div class:list={['workflow__row', `workflow__row--${row.kind}`]}>
          <h3 class="workflow__label">{row.label}</h3>
          <ol class="workflow__flow" role="list">
            {row.steps.map((step) => <li class="workflow__step">{step}</li>)}
          </ol>
          <p class="workflow__note">{row.note}</p>
        </div>
      ))}
    </div>
    <div class="agency-compare">
      <h3 class="agency-compare__title">{workflow.compare.title}</h3>
      <div class="agency-compare__table" role="table" aria-label={workflow.compare.title}>
        <div class="agency-compare__row agency-compare__row--head" role="row">
          <span role="columnheader"><span class="sr-only">Topic</span></span>
          <span role="columnheader">{workflow.compare.oldLabel}</span>
          <span role="columnheader">{workflow.compare.newLabel}</span>
        </div>
        {workflow.compare.rows.map((r) => (
          <div class="agency-compare__row" role="row">
            <span class="agency-compare__label" role="rowheader">{r.label}</span>
            <span class="agency-compare__old" role="cell">{r.old}</span>
            <span class="agency-compare__new" role="cell">{r.now}</span>
          </div>
        ))}
      </div>
    </div>
    <p class="workflow__footnote">{workflow.footnote}</p>
  </div>
</section>
