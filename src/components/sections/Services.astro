---
import { url } from '../../lib/url';
// BYQ: offthegrid-value-features-4  ·  Osmo: Masked Text Reveal
import PillButton from '../ui/PillButton.astro';
import LinkArrow from '../ui/LinkArrow.astro';
import { services } from '../../data/home';
---
<section class="services" id="services">
  <div class="container">
    <div class="services__grid">
      <div class="services__aside">
        <div class="services__head">
          <h2 class="services__title" data-split="heading" data-split-reveal="words">{services.title[0]} <span class="services__title-accent">{services.title[1]}</span></h2>
          <p class="services__intro">{services.intro}</p>
          <LinkArrow href={url('/astro')} label="Astro Development & Migrations" />
        </div>
        <div class="services__aside-bottom">
          <svg class="services__mark" viewBox="0 0 60 60" fill="currentColor" aria-hidden="true"><rect x="0" y="0" width="60" height="16" rx="8"/><rect x="0" y="22" width="60" height="16" rx="8" opacity=".6"/><rect x="0" y="44" width="60" height="16" rx="8" opacity=".3"/></svg>
          <PillButton href="#contact" label="Let’s Build Your Website" />
        </div>
      </div>

      <ul class="services__list">
        {services.items.map((s, i) => (
          <li class="service-card">
            <div class="service-card__top">
              <span class="service-card__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {s.newer && <span class="service-card__tag">Newer service</span>}
            </div>
            <div>
              <h3 class="service-card__title">{s.title}</h3>
              <p class="service-card__desc">{s.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
