---
import { url } from '../../lib/url';
// About (Astro page) — BYQ seven-nine-intro-text-1  ·  Osmo: Highlight Marker Text Reveal
import LinkArrow from '../ui/LinkArrow.astro';
import Logo from '../ui/Logo.astro';
import { about } from '../../data/astro';
---
<section class="intro intro--astro" id="about">
  <div class="container">
    <h2 class="intro__title" data-highlight-marker-reveal data-marker-theme="--marker-color" data-marker-direction="right">{about.title}</h2>
    <div class="intro__block">
      <div class="intro__halves">
        <div class="intro__media">
          <!-- TODO(AJ): your photo -->
          <div class="media-placeholder">Your photo</div>
        </div>
      </div>
      <div class="divider"></div>
      <div class="intro__halves">
        <div><span class="pill-label pill-label--logo"><Logo name="astro" />About</span></div>
        <div class="intro__content">
          <div class="intro__text">
            {about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <LinkArrow href={url('/#work')} label="See My Work" />
        </div>
      </div>
    </div>
  </div>
</section>
