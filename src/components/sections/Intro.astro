---
// BYQ: seven-nine-intro-text-1  ·  Osmo: Highlight Marker Text Reveal, Highlight Text on Scroll
import LinkArrow from '../ui/LinkArrow.astro';
---
<section class="intro" id="about">
  <div class="container">
    <h2 class="intro__title" data-highlight-marker-reveal data-marker-theme="--marker-color" data-marker-direction="right">More than just building what's in the Figma.</h2>

    <div class="intro__block">
      <div class="intro__halves">
        <div class="intro__media">
          <!-- TODO(AJ): secondary image (workspace / process shot) -->
          <div class="media-placeholder">Image</div>
        </div>
      </div>

      <div class="divider"></div>

      <div class="intro__halves">
        <div><span class="pill-label">About</span></div>
        <div class="intro__content">
          <div class="intro__text">
            <p data-highlight-text data-highlight-fade="0.25">I'm AJ, a Webflow Developer with 3+ years of professional agency experience building and maintaining websites for international clients.</p>
            <p>My work goes beyond translating designs into pages. I think about how a website should behave across breakpoints, how its CMS should scale, how components should be structured, where custom code is appropriate, and what needs to happen before a site is ready for production.</p>
            <p>I also have a strong design background, which helps me catch inconsistencies in spacing, typography, hierarchy and interaction before they become QA problems.</p>
          </div>
          <LinkArrow href="#services" label="What I Do" />
        </div>
      </div>
    </div>
  </div>
</section>
