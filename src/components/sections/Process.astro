---
// BYQ: kelvin-process-1  ·  Osmo: Masked Text Reveal  ·  line fill on scroll (main.js)
// Defaults = /astro migration process; the homepage passes its 5-step client process.
import { steps as astroSteps } from '../../data/astro';
import Logo from '../ui/Logo.astro';
interface Props {
  steps?: { num: string; title: string; copy: string }[];
  title?: [string, string];
  eyebrow?: string;
  intro?: string;
}
const {
  steps = astroSteps,
  title = ['Four steps,', 'zero surprises.'],
  eyebrow = 'How a migration works',
  intro,
} = Astro.props;
---
<section class:list={['process', { 'process--five': steps.length === 5, 'process--six': steps.length === 6 }]} id="process">
  <div class="container">
    <div class="process__head">
      {eyebrow && <div class="process__eyebrow"><Logo name="astro" class="process__logo" />{eyebrow}</div>}
      <h2 class="process__title section-title" data-split="heading"><span class="process__title-dim">{title[0]}</span> {title[1]}</h2>
      {intro && <p class="process__intro">{intro}</p>}
    </div>
    <div class="process__rail">
      <div class="process__line" aria-hidden="true"><div class="process__line-fill" data-process-line></div></div>
      <ol class="process__track">
        {steps.map((s) => (
          <li class="process__step">
            <span class="process__node" aria-hidden="true"></span>
            <span class="process__num" aria-hidden="true">{s.num}</span>
            <h3 class="process__step-title">{s.title}</h3>
            <p class="process__copy">{s.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
