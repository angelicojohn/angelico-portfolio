---
// Turnaround targets + preview / completed / launch stages.  ·  Osmo: Masked Text Reveal
// Timelines are proposed TARGETS (see src/data/home.ts), not guarantees.
import { timelines } from '../../data/home';
---
<section class="timelines" id="turnaround">
  <div class="container">
    <div class="timelines__head">
      <h2 class="timelines__title section-title" data-split="heading">
        {timelines.title.map((line) => <span>{line} </span>)}
      </h2>
      <p class="timelines__intro">{timelines.intro}</p>
    </div>
    <ul class="timelines__grid" role="list">
      {timelines.items.map((t, i) => (
        <li class:list={['timeline-card', { 'is--accent': i === 1 }]}>
          <span class="timeline-card__kicker">Target</span>
          <p class="timeline-card__time">{t.time}</p>
          <h3 class="timeline-card__name">{t.name}</h3>
          <p class="timeline-card__text">{t.text}</p>
        </li>
      ))}
    </ul>
    <ol class="timelines__stages" role="list">
      {timelines.stages.map((s) => (
        <li class="timelines__stage">
          <span class="timelines__stage-node" aria-hidden="true"></span>
          <h3 class="timelines__stage-title">{s.title}</h3>
          <p class="timelines__stage-text">{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="timelines__factors">{timelines.factors}</p>
  </div>
</section>
