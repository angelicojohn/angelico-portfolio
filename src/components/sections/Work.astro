---
import { url } from '../../lib/url';
// BYQ: strobe-cms-grid-5  ·  Osmo: Masked Text Reveal  ·  Strobe cursor follower
import { work } from '../../data/work';
---
<section class="work" id="work">
  <div class="container">
    <div class="work__head">
      <h2 class="work__title">
        <span data-split="heading">Selected</span>
        <span data-split="heading">Work</span>
      </h2>
      <div class="work__intro">
        <h3 class="work__eyebrow">Production Webflow work</h3>
        <p class="work__lede">A selection of websites I've built, developed or maintained professionally.</p>
      </div>
    </div>

    <ul class="work__grid">
      {work.map((item) => (
        <li>
          <a href={item.url ?? '#'} class="work-card" data-work-card target={item.url ? '_blank' : undefined} rel={item.url ? 'noopener' : undefined}>
            <div class="work-card__media" data-work-shot>
              {item.image
                ? <img class="work-card__shot" src={url(item.image)} alt={`Full-page screenshot of the ${item.title} website`} loading="lazy" />
                : <div class="media-placeholder">Full-page screenshot</div>}
            </div>
            <div class="work-card__body">
              <h3 class="work-card__title">{item.title}</h3>
              <dl class="work-card__meta">
                <dt>My Role</dt>
                <dd>{item.role}</dd>
                <dt>Contribution</dt>
                <dd>{item.contribution.join(' · ')}</dd>
              </dl>
              <p class="work-card__desc">{item.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="work-cursor" data-work-cursor aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none"><path d="M4.8 24h37.8" stroke="currentColor" stroke-width="4" stroke-linecap="square"/><path d="M24 4.8 43.2 24 24 43.2" stroke="currentColor" stroke-width="4" stroke-linecap="square"/></svg>
  </div>
</section>
