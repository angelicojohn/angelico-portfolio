---
// BYQ: strobe-cms-grid-5  ·  Osmo: Masked Text Reveal  ·  Strobe cursor follower
import ProjectCard from '../ui/ProjectCard.astro';
import LinkArrow from '../ui/LinkArrow.astro';
import { featured, projects } from '../../data/projects';
import { url } from '../../lib/url';
interface Props {
  all?: boolean;
  heading?: [string, string];
  eyebrow?: string;
  lede?: string;
  id?: string;
}
const {
  all = false,
  heading = ['Selected', 'Work'],
  eyebrow = 'Production Webflow work',
  lede = "A selection of websites I've built, developed or maintained professionally.",
  id = 'work',
} = Astro.props;
const list = all ? projects : featured;
---
<section class:list={['work', { 'work--all': all }]} id={id}>
  <div class="container">
    {!all && (
      <div class="work__head">
        <h2 class="work__title">
          <span data-split="heading">{heading[0]}</span>
          <span data-split="heading">{heading[1]}</span>
        </h2>
        <div class="work__intro">
          <h3 class="work__eyebrow">{eyebrow}</h3>
          <p class="work__lede">{lede}</p>
        </div>
      </div>
    )}

    {all && (
      <div class="work__filters" role="group" aria-label="Filter projects by platform" data-work-filters>
        <button type="button" class="work__filter is--active" data-filter="all" aria-pressed="true">All <span>{projects.length}</span></button>
        {['Webflow', 'Framer'].map((pl) => (
          <button type="button" class="work__filter" data-filter={pl} aria-pressed="false">{pl} <span>{projects.filter((p) => p.platform === pl).length}</span></button>
        ))}
      </div>
    )}

    <ul class="work__grid">
      {list.map((p) => <li data-platform={p.platform}><ProjectCard project={p} /></li>)}
    </ul>

    {!all && (
      <div class="work__more">
        <LinkArrow href={url('/projects')} label={`View all ${projects.length} projects`} />
      </div>
    )}
  </div>

  <div class="work-cursor" data-work-cursor aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none"><path d="M4.8 24h37.8" stroke="currentColor" stroke-width="4" stroke-linecap="square"/><path d="M24 4.8 43.2 24 24 43.2" stroke="currentColor" stroke-width="4" stroke-linecap="square"/></svg>
  </div>
</section>
