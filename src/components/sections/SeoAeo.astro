---
// SEO + AEO included — two checklists in the blue Consult AI style  ·  Osmo: Masked Text Reveal
import { seo } from '../../data/astro';
---
<section class="experience seoaeo" id="seo">
  <div class="container">
    <div class="seoaeo__head">
      <span class="experience__tag">Included from the Growth Website up</span>
      <h2 class="experience__title seoaeo__title section-title" data-split="heading">{seo.title.map((line) => <span class="seoaeo__line">{line} </span>)}</h2>
      <p class="seoaeo__intro">{seo.intro}</p>
    </div>
    <div class="seoaeo__grid">
      <div class="seoaeo__card">
        <h3 class="seoaeo__card-title">SEO <span>Search engines</span></h3>
        <ul class="seoaeo__list">{seo.seo.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="seoaeo__card">
        <h3 class="seoaeo__card-title">AEO <span>AI answer engines</span></h3>
        <ul class="seoaeo__list">{seo.aeo.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
    <p class="seoaeo__note">{seo.note}</p>
  </div>
</section>
